# Dashboard access. Generate the session secret with: python scripts/generate_secret.py
APP_ADMIN_PASSWORD=choose-a-long-unique-password
APP_SESSION_SECRET=replace-with-a-random-64-character-secret
# Machine credential for the relay, separate from your password so it can be
# rotated on its own. Generate with: python scripts/generate_secret.py
APP_GATEWAY_TOKEN=
APP_COOKIE_SECURE=false

# Local EcoFlow BLE collector: the numeric User ID of the EcoFlow account the
# units are bound to (see "Getting your EcoFlow User ID" in the README).
# It is not your EcoFlow password.
# Devices are identified by the serial number in their BLE advertisement,
# so no device name or address needs configuring.
ECOFLOW_USER_ID=
ECOFLOW_POLL_SECONDS=15

# Path to rabits/ha-ef-ble after running scripts/bootstrap_eflib.sh.
ECOFLOW_EFLIB_ROOT=vendor/ha-ef-ble/custom_components/ef_ble/eflib
